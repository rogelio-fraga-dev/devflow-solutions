# ============================================================
# DevFlow Solutions — variáveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores em produção.
# O docker-compose lê o .env automaticamente; sem ele, usa os
# defaults de desenvolvimento (funciona de primeira para avaliação).
# ============================================================

# --- Banco de Dados PostgreSQL ---
POSTGRES_DB=devflow_db
POSTGRES_USER=devflow_user
POSTGRES_PASSWORD=troque-esta-senha-em-producao

# --- Segredo do JWT (HMAC-SHA256) ---
# Em produção use uma chave forte e única (>= 32 caracteres).
API_SECURITY_TOKEN_SECRET=troque-este-segredo-por-uma-chave-forte-e-unica
